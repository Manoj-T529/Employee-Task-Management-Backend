generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id            String    @id @db.Char(36)
  email         String    @unique
  username      String    @unique
  password_hash String
  first_name    String?
  last_name     String?
  role          String?
  status        String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  reported_tasks tasks[]          @relation("UserReportedTasks")
  assigned_tasks task_assignees[]
}

model projects {
  id          String    @id @db.Char(36)
  name        String
  description String?
  created_by  String
  start_date  DateTime?
  end_date    DateTime?
  status      String?
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  tasks tasks[]
}

model tasks {
  id           String    @id @db.Char(36)
  project_id   String
  title        String
  description  String?
  status_id    Int
  priority_id  Int
  reporter_id  String
  start_date   DateTime?
  due_date     DateTime?
  story_points Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  project        projects         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  reporter       users            @relation("UserReportedTasks", fields: [reporter_id], references: [id])
  task_assignees task_assignees[]
  task_comments  task_comments[]

  @@index([project_id, status_id]) // Super fast Kanban board loading
  @@index([due_date]) // Super fast Calendar queries
  @@index([reporter_id]) // Fast "My Tasks" queries
  @@index([deleted_at])
}

model task_assignees {
  id          String   @id @db.Char(36)
  task_id     String
  user_id     String
  assigned_by String?
  assigned_at DateTime @default(now())

  task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([task_id])
  @@index([user_id])
}

model task_comments {
  id           String   @id @db.Char(36)
  task_id      String
  user_id      String
  comment_text String
  created_at   DateTime @default(now())

  task tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
}

model lookups {
  id            Int     @id @default(autoincrement())
  type          String
  code          String
  value         String?
  display_order Int?
}

model audit_logs {
  id           String   @id @db.Char(36)
  entity_type  String
  entity_id    String
  action       String
  old_value    Json?
  new_value    Json?
  performed_by String
  performed_at DateTime @default(now())

  @@index([entity_type, entity_id])
}
